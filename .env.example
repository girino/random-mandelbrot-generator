# Optional binary locations.
FRACT_BIN=fract
NAK_BIN=nak

# NIP-46 bunker URI. Keep the real value only in .env.
FRACT_BUNKER_URI=bunker://...

# Publishing destinations.
FRACT_BLOSSOM_SERVER=https://blossom.primal.net
FRACT_RELAYS=wss://relay.damus.io,wss://nos.lol

# Final PNG and metadata directory.
FRACT_OUTPUT_DIR=/path/to/fract
